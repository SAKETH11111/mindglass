# Cerebras API Configuration
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_DEFAULT_MODEL=gpt-oss-120b
CEREBRAS_FALLBACK_MODEL=zai-glm-4.7
CEREBRAS_STREAM_MAX_RETRIES=0
CEREBRAS_MAX_PARALLEL_AGENTS=1
CEREBRAS_WARM_TCP_CONNECTION=false

# Optional OpenRouter fallback for rate limits / empty provider responses
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MIN_MAX_TOKENS=220
OPENROUTER_PROVIDER_SORT=throughput

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:5173
